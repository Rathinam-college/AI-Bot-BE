# Server Ports & URLs
CHATBOT_PORT=8000
MOCK_SERVER_PORT=8085
TARGET_SERVER_BASE_URL=http://127.0.0.1:8085

# Target Software 1 Configuration (CCTV)
APP1_NAME="CCTV"
APP1_URL=http://127.0.0.1:8085/app1
APP1_USERNAME=admin_app1
APP1_PASSWORD=secret_app1_pass

# Target Software 2 Configuration (Food)
APP2_NAME="Food"
APP2_URL=http://127.0.0.1:8085/app2
APP2_USERNAME=admin_app2
APP2_PASSWORD=secret_app2_pass

# Target Software 3 Configuration (Transport)
APP3_NAME="Transport"
APP3_URL=http://127.0.0.1:8085/app3
APP3_USERNAME=admin_app3
APP3_PASSWORD=secret_app3_pass



# SQLite Database Location
SQLITE_DB_PATH=database/app_data.db

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

